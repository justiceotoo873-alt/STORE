# Copy to .env.local for local tests, or set these in Vercel for the STORE project.
# Public Supabase project URL and publishable key (browser-safe).
NEXT_PUBLIC_SUPABASE_URL=https://jatxzdmrasozbipsfmqy.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_PUBLIC_KEY_HERE

# SECRET: Server-only service-role key for order creation and payment verification.
# Never prefix this with NEXT_PUBLIC_, store in HTML, or commit it to git.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVER_SIDE_SERVICE_ROLE_KEY

# SECRET: Use sk_test_... to test first. Replace with sk_live_... only after review.
PAYSTACK_SECRET_KEY=sk_test_YOUR_PAYSTACK_SECRET_KEY

# Your HTTPS production store origin; checkout callback uses this EXACT value.
STORE_ORIGIN=https://your-store-domain.example

# SECRET: Vercel sends this in the Authorization header to the daily
# missed-webhook reconciliation backstop. Generate a random 32+ character value.
# Never add NEXT_PUBLIC_ or share it with customers.
CRON_SECRET=GENERATE_A_LONG_RANDOM_SERVER_ONLY_VALUE

# OPTIONAL: the WhatsApp group customers are invited to after a confirmed payment.
# Must be a genuine HTTPS WhatsApp invite link (chat.whatsapp.com/…, wa.me/… or
# whatsapp.com/…). If this is empty or invalid, the thank-you page simply says the
# invite is being set up — it never links anywhere unverified.
NEXT_PUBLIC_WHATSAPP_GROUP_URL=https://chat.whatsapp.com/YOUR_GROUP_INVITE_CODE

# CUSTOMER SUPPORT chat (floating button, footer CTA, failed-payment page).
# International format without "+" is safest; +233… and 0592… also work.
# Default when unset: 233592060208
NEXT_PUBLIC_SUPPORT_WHATSAPP=233592060208
